# LLM provider: omniroute | openrouter | groq | custom
# OmniRoute is the recommended setup: run it separately on localhost:20128.
LLM_PROVIDER=omniroute

# OmniRoute (OpenAI-compatible local gateway)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto
OMNIROUTE_VISION_MODEL=auto

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o

# Groq (use these when LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Custom OpenAI-compatible provider (use these when LLM_PROVIDER=custom)
CUSTOM_API_KEY=your_custom_api_key_here
CUSTOM_BASE_URL=https://your-provider.example.com/v1
CUSTOM_MODEL=your-model
CUSTOM_VISION_MODEL=your-vision-model

PORT=3000
