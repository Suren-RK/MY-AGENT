# LLM provider: ollama | groq | openrouter | custom
# Ollama is the default local provider and does not require an API key.
LLM_PROVIDER=ollama

# Ollama (local; install Ollama and pull these models first)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_VISION_MODEL=qwen3-vl:2b

# Optional cloud fallback: use when LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# OpenRouter (use these when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o

# Custom OpenAI-compatible provider (use these when LLM_PROVIDER=custom)
CUSTOM_API_KEY=your_custom_api_key_here
CUSTOM_BASE_URL=https://your-provider.example.com/v1
CUSTOM_MODEL=your-model
CUSTOM_VISION_MODEL=your-vision-model

PORT=3000
